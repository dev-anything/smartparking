@model List<ParkingDashboard.Models.Vehicle>
@{ ViewData["Title"] = "차량 관리"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-car-front-fill"></i> 차량 관리</h3>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> 차량 등록
    </a>
</div>

<form method="get" class="card card-body border-0 shadow-sm mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small">검색 (차량번호/이름/전화번호)</label>
            <input type="text" name="search" value="@(ViewBag.Search ?? "")" class="form-control" placeholder="예: 12가 3456, 홍길동" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> 검색</button>
        </div>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>차량번호</th>
                        <th>소유자</th>
                        <th>계좌번호</th>
                        <th>전화번호</th>
                        <th>등록일</th>
                        <th>비고</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">등록된 차량이 없습니다.</td></tr>
                    }
                    @foreach (var v in Model)
                    {
                        <tr>
                            <td class="fw-bold">@v.PlateNumber</td>
                            <td>@v.OwnerName</td>
                            <td class="text-muted">@v.AccountNumber</td>
                            <td>@v.PhoneNumber</td>
                            <td>@v.RegisteredAt.ToString("yyyy-MM-dd")</td>
                            <td class="text-muted small">@(v.Memo ?? "")</td>
                            <td class="text-end">
                                <a href="@Url.Action("Details", new { id = v.PlateNumber })" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                <a href="@Url.Action("Edit", new { id = v.PlateNumber })" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                <form method="post" asp-action="Delete" asp-controller="Vehicles" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@v.PlateNumber" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('정말 삭제할까요?');"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
