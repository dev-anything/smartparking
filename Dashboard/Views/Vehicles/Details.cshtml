@model ParkingDashboard.Models.Vehicle
@{
    ViewData["Title"] = "차량 상세";
    var records = ViewBag.Records as List<ParkingDashboard.Models.EntryExitRecord> ?? new();
    var fees = ViewBag.Fees as List<ParkingDashboard.Models.Fee> ?? new();
    var totalFee = fees.Sum(f => f.Amount);
}

<h3 class="mb-3"><i class="bi bi-info-circle"></i> 차량 상세 정보</h3>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><i class="bi bi-person-vcard"></i> 기본 정보</div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr><th class="text-muted" style="width:140px;">차량번호</th><td class="fw-bold">@Model.PlateNumber</td></tr>
                    <tr><th class="text-muted">소유자</th><td>@Model.OwnerName</td></tr>
                    <tr><th class="text-muted">계좌번호</th><td>@Model.AccountNumber</td></tr>
                    <tr><th class="text-muted">전화번호</th><td>@Model.PhoneNumber</td></tr>
                    <tr><th class="text-muted">등록일</th><td>@Model.RegisteredAt.ToString("yyyy-MM-dd")</td></tr>
                    <tr><th class="text-muted">비고</th><td>@(Model.Memo ?? "-")</td></tr>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><i class="bi bi-bar-chart"></i> 요약</div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr><th class="text-muted">입출입 기록</th><td>@records.Count 건 (최근 30건 기준)</td></tr>
                    <tr><th class="text-muted">누적 결제</th><td>@totalFee.ToString("N0") 원</td></tr>
                </table>
                <div class="mt-3 d-flex gap-2">
                    <a href="@Url.Action("Edit", new { id = Model.PlateNumber })" class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i> 수정</a>
                    <a href="@Url.Action("Index")" class="btn btn-sm btn-secondary"><i class="bi bi-arrow-left"></i> 목록</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white"><i class="bi bi-clock-history"></i> 입출입 기록 (최근 30건)</div>
    <div class="card-body p-0">
        <table class="table table-sm mb-0">
            <thead class="table-light"><tr><th>입차</th><th>출차</th><th>주차시간</th><th>출처</th><th>상태</th></tr></thead>
            <tbody>
                @if (!records.Any()) { <tr><td colspan="5" class="text-center text-muted py-3">기록 없음</td></tr> }
                @foreach (var e in records)
                {
                    <tr>
                        <td>@e.EntryTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(e.ExitTime?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                        <td>@{
                                int? m = e.DurationMinutes;
                                if (m == null) { var live = (int)Math.Round((DateTime.UtcNow - e.EntryTime).TotalMinutes); @($"{live / 60}시간 {live % 60}분") }
                                else { var v = m.Value; @($"{v / 60}시간 {v % 60}분") }
                            }</td>
                        <td>@e.Source</td>
                        <td>@(e.IsParked ? "주차중" : "완료")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white"><i class="bi bi-cash-coin"></i> 결제 내역 (최근 30건)</div>
    <div class="card-body p-0">
        <table class="table table-sm mb-0">
            <thead class="table-light"><tr><th>결제일시</th><th>입차</th><th>출차</th><th>주차(분)</th><th>수단</th><th class="text-end">금액</th></tr></thead>
            <tbody>
                @if (!fees.Any()) { <tr><td colspan="6" class="text-center text-muted py-3">결제 없음</td></tr> }
                @foreach (var f in fees)
                {
                    <tr>
                        <td>@f.PaidAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@f.EntryTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@f.ExitTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@f.ParkedMinutes</td>
                        <td>@f.PaymentMethod</td>
                        <td class="text-end">@f.Amount.ToString("N0")원</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
