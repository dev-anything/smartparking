@model ParkingDashboard.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "로그인";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>로그인 - 공용주차장 관리자</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            display: flex; align-items: center; justify-content: center;
        }
        .login-card {
            max-width: 420px; width: 100%;
            border: none; border-radius: 1rem;
            box-shadow: 0 20px 50px rgba(0,0,0,.25);
            overflow: hidden;
        }
        .login-header { background: #0d1b2a; color: #fff; padding: 1.5rem; text-align: center; }
        .login-header h1 { font-size: 1.2rem; margin: 0; }
        .login-body { padding: 1.75rem; background: #fff; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-header">
            <i class="bi bi-p-square-fill text-warning" style="font-size:2rem;"></i>
            <h1 class="mt-2">공용주차장 관리자</h1>
            <small class="text-secondary">관리자 계정으로 로그인하세요</small>
        </div>
        <div class="login-body">
            <form method="post" asp-controller="Account" asp-action="Login">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger small mb-2"></div>
                <div class="mb-3">
                    <label asp-for="Username" class="form-label">아이디</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="Username" class="form-control" autocomplete="username" />
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">비밀번호</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-box-arrow-in-right"></i> 로그인
                </button>
            </form>
            <div class="text-center small text-muted mt-3">
                기본 계정: <code>admin</code> / <code>admin1234</code>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
