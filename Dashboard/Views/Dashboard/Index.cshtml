@{
    ViewData["Title"] = "대시보드";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0"><i class="bi bi-speedometer2"></i> 주차 현황 대시보드</h3>
    <span class="text-muted small" id="currentTime">-</span>
</div>

<!-- 상단 KPI 카드 -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card kpi-card border-0 shadow-sm">
            <div class="card-body">
                <div class="kpi-label">총 주차면</div>
                <div class="kpi-value text-primary" id="totalSpots">-<small class="text-muted">면</small></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card border-0 shadow-sm">
            <div class="card-body">
                <div class="kpi-label">현재 주차</div>
                <div class="kpi-value text-danger" id="occupiedSpots">-<small class="text-muted">대</small></div>
                <div class="kpi-sub" id="availableSpots">여유 - 대</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card border-0 shadow-sm">
            <div class="card-body">
                <div class="kpi-label">오늘 입차/출차</div>
                <div class="kpi-value text-success" id="todayEntriesExits">
                    - <small class="text-muted fs-6">/ -</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card border-0 shadow-sm">
            <div class="card-body">
                <div class="kpi-label">오늘 수익</div>
                <div class="kpi-value text-warning" id="todayRevenue">-<small class="text-muted">원</small></div>
                <div class="kpi-sub" id="monthRevenue">이번 달 -원</div>
            </div>
        </div>
    </div>
</div>

<!-- 주차 자리 현황 (ESP32 초음파 센서) -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span><i class="bi bi-grid-3x3-gap-fill"></i> 주차 자리 현황 (ESP32 초음파 센서)</span>
        <small class="text-muted">
            점유 <strong class="text-danger" id="spotsOccupied">-</strong> ·
            빈자리 <strong class="text-success" id="spotsEmpty">-</strong> ·
            미확인 <strong class="text-secondary" id="spotsUnknown">-</strong>
            <span class="ms-2" id="lastSensorUpdate"></span>
        </small>
    </div>
    <div class="card-body">
        <div class="parking-box">
            <div class="parking-grid" id="parkingGrid">
                <div class="text-center text-muted py-5">
                    <i class="bi bi-wifi-off" style="font-size: 2rem;"></i><br>
                    ESP32 센서 데이터 대기중...<br>
                    <small>차량이 들어오면 자동으로 표시됩니다</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 차단기 상태 -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white">
        <i class="bi bi-barrier"></i> 차단기 상태
    </div>
    <div class="card-body">
        <div class="row g-3" id="barrierList">
            <div class="text-center text-muted">차단기 데이터 대기중...</div>
        </div>
    </div>
</div>

<!-- 현재 주차 차량 + 최근 입출입 -->
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-car-front"></i> 현재 주차 차량</span>
                <span class="badge bg-primary" id="currentVehicleCount">0 대</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 420px;">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>차량번호</th>
                                <th>입차시각</th>
                                <th>주차시간</th>
                            </tr>
                        </thead>
                        <tbody id="currentVehicles">
                            <tr><td colspan="3" class="text-center text-muted py-4">ESP32 센서 데이터 대기중...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <i class="bi bi-clock-history"></i> 최근 입출입 활동
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 420px;">
                    <table id="recentActivity" class="table table-sm table-hover mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>차량번호</th>
                                <th>입차</th>
                                <th>출차</th>
                                <th>상태</th>
                            </tr>
                        </thead>
                        <tbody id="recentActivityBody">
                            <tr><td colspan="4" class="text-center text-muted py-4">서버에서 데이터 로딩중...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- API 상태 표시 -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white">
        <i class="bi bi-hdd-network"></i> API 연결 상태
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="alert alert-secondary mb-0" id="api1-status">
                    <i class="bi bi-circle"></i> /api/parked-status
                </div>
            </div>
            <div class="col-md-4">
                <div class="alert alert-secondary mb-0" id="api2-status">
                    <i class="bi bi-circle"></i> /api/entry-exit-records
                </div>
            </div>
            <div class="col-md-4">
                <div class="alert alert-secondary mb-0" id="api3-status">
                    <i class="bi bi-circle"></i> /api/llm-query
                </div>
            </div>
        </div>
    </div>
</div>

<!-- LLM 쿼리 테스트 -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white">
        <i class="bi bi-robot"></i> LLM 질의 테스트 (실제 API 호출)
    </div>
    <div class="card-body">
        <div class="input-group">
            <input type="text" id="llmQuestion" class="form-control" 
                   placeholder="질문을 입력하세요 (예: 오늘 입차 수는?, 현재 주차 차량 수는?)" />
            <button class="btn btn-primary" type="button" id="llmSubmit">질문</button>
        </div>
        <pre id="llmResult" class="mt-3 p-3 bg-light border rounded" 
             style="min-height: 80px; white-space: pre-wrap; font-family: monospace;">여기에 답변이 표시됩니다...</pre>
    </div>
</div>

@section Scripts {
<script>
(function() {
    const API_BASE = 'http://192.168.0.7:10001/api';
    const REFRESH_INTERVAL = 3000;
    
    // API 상태 업데이트 (초록:성공, 빨강:실패)
    function setApiStatus(apiNum, success) {
        const el = document.getElementById(`api${apiNum}-status`);
        if (!el) return;
        el.className = 'alert alert-' + (success ? 'success' : 'danger') + ' mb-0';
        el.innerHTML = '<i class="bi bi-' + (success ? 'check-circle' : 'x-circle') + '"></i> ' + el.textContent.substring(2);
    }
    
    // 주차 자리 그리드 렌더링 (ESP32 데이터만 표시)
    function renderParkingGrid(spots) {
        const grid = document.getElementById('parkingGrid');
        if (!grid) return;
        
        // ESP32 데이터가 없으면 대기 메시지 표시
        if (!spots || spots.length === 0) {
            grid.innerHTML = '<div class="text-center text-muted py-5">' +
                '<i class="bi bi-wifi-off" style="font-size: 2rem;"></i><br>' +
                'ESP32 센서 데이터 대기중...<br>' +
                '<small>차량이 들어오면 자동으로 표시됩니다</small></div>';
            return;
        }
        
        const leftSpots = spots.filter(s => s.zone === 'L').sort((a,b) => a.spot_number.localeCompare(b.spot_number));
        const rightSpots = spots.filter(s => s.zone === 'R').sort((a,b) => a.spot_number.localeCompare(b.spot_number));
        const maxRows = Math.max(leftSpots.length, rightSpots.length);
        
        let html = '';
        for (let i = 0; i < maxRows; i++) {
            const lspot = leftSpots[i];
            const rspot = rightSpots[i];
            
            html += '<div class="parking-row">';
            
            // 좌측 자리 - ESP32 데이터 있을 때만 표시
            if (lspot) {
                const cls = lspot.is_occupied ? 'cell-occupied' : lspot.status === 'Empty' ? 'cell-empty' : 'cell-unknown';
                const title = `${lspot.spot_number} | ${lspot.status}` +
                             (lspot.distance_cm ? ` | 거리: ${lspot.distance_cm}cm` : '') +
                             (lspot.occupied_by ? ` | 차량: ${lspot.occupied_by}` : '') +
                             ` | 갱신: ${new Date(lspot.last_updated).toLocaleTimeString()}`;
                html += `<div class="cell ${cls}" data-spot="${lspot.spot_number}" title="${title}">${lspot.spot_number}</div>`;
            } else {
                html += '<div class="cell cell-empty"></div>';
            }
            
            // 중앙 통로
            if (i === 0) {
                html += '<div class="cell cell-aisle" style="border:none;background:transparent;">입구</div>';
            } else {
                html += '<div class="cell cell-aisle"></div>';
            }
            
            // 우측 자리 - ESP32 데이터 있을 때만 표시
            if (rspot) {
                const cls = rspot.is_occupied ? 'cell-occupied' : rspot.status === 'Empty' ? 'cell-empty' : 'cell-unknown';
                const title = `${rspot.spot_number} | ${rspot.status}` +
                             (rspot.distance_cm ? ` | 거리: ${rspot.distance_cm}cm` : '') +
                             (rspot.occupied_by ? ` | 차량: ${rspot.occupied_by}` : '') +
                             ` | 갱신: ${new Date(rspot.last_updated).toLocaleTimeString()}`;
                html += `<div class="cell ${cls}" data-spot="${rspot.spot_number}" title="${title}">${rspot.spot_number}</div>`;
            } else {
                html += '<div class="cell cell-empty"></div>';
            }
            
            html += '</div>';
        }
        grid.innerHTML = html;
    }
    
    // 차단기 상태 렌더링
    function renderBarriers(barriers) {
        const list = document.getElementById('barrierList');
        if (!list) return;
        
        if (!barriers || barriers.length === 0) {
            list.innerHTML = '<div class="text-center text-muted">차단기 데이터 대기중...</div>';
            return;
        }
        
        list.innerHTML = barriers.map(b => `
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <strong>${b.display_name}</strong>
                            <div class="text-muted small">${b.location}</div>
                        </div>
                        <span class="badge ${b.status === 'Open' ? 'text-bg-success' : 'text-bg-secondary'}" 
                              data-barrier="${b.gate_code}">
                            ${b.status === 'Open' ? '개방' : '폐쇄'}
                        </span>
                    </div>
                </div>
            </div>
        `).join('');
    }
    
    // 현재 주차 차량 렌더링 (ESP32 데이터만)
    function renderCurrentVehicles(vehicles) {
        const tbody = document.getElementById('currentVehicles');
        const count = document.getElementById('currentVehicleCount');
        if (!tbody || !count) return;
        
        // ESP32 데이터가 없으면 대기 메시지
        if (!vehicles || vehicles.length === 0) {
            count.textContent = '0 대';
            tbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted py-4">ESP32 센서 데이터 대기중...</td></tr>';
            return;
        }
        
        count.textContent = vehicles.length + '대';
        
        tbody.innerHTML = vehicles.map(v => {
            const entryTime = new Date(v.entry_time);
            const duration = Math.floor((new Date() - entryTime) / 60000);
            const hours = Math.floor(duration / 60);
            const mins = duration % 60;
            return `<tr>
                <td class="fw-bold">${v.plate_number || '-'}</td>
                <td>${entryTime.toLocaleString('ko-KR', {month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'})}</td>
                <td>${hours}시간 ${mins}분</td>
            </tr>`;
        }).join('');
    }
    
    // 최근 입출입 기록 렌더링 (API 2)
    function renderRecentActivity(records) {
        const tbody = document.getElementById('recentActivityBody');
        if (!tbody) return;
        
        if (!records || records.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-4">최근 입출입 기록이 없습니다.</td></tr>';
            return;
        }
        
        tbody.innerHTML = records.map(r => `
            <tr>
                <td class="fw-bold">${r.plate_number || '-'}</td>
                <td>${new Date(r.entry_time).toLocaleString('ko-KR', {month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'})}</td>
                <td>${r.exit_time ? new Date(r.exit_time).toLocaleString('ko-KR', {month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'}) : '-'}</td>
                <td><span class="badge ${r.status === 'parked' ? 'text-bg-warning' : 'text-bg-success'}">${r.status === 'parked' ? '주차중' : '완료'}</span></td>
            </tr>
        `).join('');
    }
    
    // API 1: 주차 현황 조회 - ESP32 데이터
    async function fetchParkedStatus() {
        try {
            const res = await fetch(`${API_BASE}/parked-status`);
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const data = await res.json();
            
            if (!data.ok) return;
            
            // 성공 상태 표시
            setApiStatus(1, true);
            
            // KPI 업데이트
            document.getElementById('totalSpots').innerHTML = (data.total_spots || 0) + '<small class="text-muted">면</small>';
            document.getElementById('occupiedSpots').innerHTML = (data.spots_summary?.occupied || 0) + '<small class="text-muted">대</small>';
            document.getElementById('availableSpots').textContent = '여유 ' + (data.spots_summary?.empty || 0) + ' 대';
            document.getElementById('todayEntriesExits').innerHTML = 
                (data.stats?.today_entries || 0) + '<small class="text-muted fs-6">/ ' + (data.stats?.today_exits || 0) + '</small>';
            document.getElementById('todayRevenue').innerHTML = 
                Number(data.stats?.today_revenue || 0).toLocaleString() + '<small class="text-muted">원</small>';
            document.getElementById('monthRevenue').textContent = 
                '이번 달 ' + Number(data.stats?.month_revenue || 0).toLocaleString() + '원';
            
            // 자리 현황 - ESP32 데이터만 표시
            document.getElementById('spotsOccupied').textContent = data.spots_summary?.occupied || 0;
            document.getElementById('spotsEmpty').textContent = data.spots_summary?.empty || 0;
            document.getElementById('spotsUnknown').textContent = data.spots_summary?.unknown || 0;
            if (data.timestamp) {
                document.getElementById('lastSensorUpdate').textContent = 
                    '마지막 갱신: ' + new Date(data.timestamp).toLocaleTimeString();
            }
            
            // ESP32 센서 데이터로만 표시 (하드코딩 제거)
            renderParkingGrid(data.spots);
            renderBarriers(data.barriers);
            renderCurrentVehicles(data.current_vehicles);
            
        } catch (e) {
            console.warn('parked-status API 오류:', e.message);
            setApiStatus(1, false);
        }
    }
    
    // API 2: 입출입 기록 조회
    async function fetchEntryExitRecords() {
        try {
            const res = await fetch(`${API_BASE}/entry-exit-records?limit=10&status=all`);
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const data = await res.json();
            
            setApiStatus(2, true);
            
            if (data.records) {
                renderRecentActivity(data.records);
            }
        } catch (e) {
            console.warn('entry-exit-records API 오류:', e.message);
            setApiStatus(2, false);
        }
    }
    
    // API 3: LLM 질의 - 실제 서버로 전송
    async function queryLLM(question) {
        const resultBox = document.getElementById('llmResult');
        if (!resultBox || !question) return;
        
        resultBox.textContent = '서버로 질의 전송중...';
        setApiStatus(3, false);
        
        try {
            const res = await fetch(`${API_BASE}/llm-query`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ question: question })
            });
            
            if (!res.ok) {
                const errText = await res.text();
                throw new Error('HTTP ' + res.status + ': ' + errText);
            }
            
            // 서버에서 raw SQL 문자열 반환
            const sql = await res.text();
            setApiStatus(3, true);
            
            resultBox.textContent = '✅ 생성된 SQL 쿼리:\n\n' + sql + 
                '\n\n[주의] 이 SQL 은 쿼리만 생성합니다.\n실행 결과는 백엔드에서 처리해야 합니다.';
            
        } catch (e) {
            setApiStatus(3, false);
            resultBox.textContent = '❌ 오류 발생:\n' + e.message + 
                '\n\n서버 (http://192.168.0.7:10001) 가 실행 중인지 확인하세요.';
        }
    }
    
    // 시간 업데이트
    function updateTime() {
        const now = new Date();
        document.getElementById('currentTime').textContent = 
            now.toLocaleString('ko-KR', {year:'numeric',month:'2-digit',day:'2-digit',weekday:'short',hour:'2-digit',minute:'2-digit'});
    }
    
    // LLM 질문 버튼 이벤트
    document.getElementById('llmSubmit')?.addEventListener('click', function() {
        const question = document.getElementById('llmQuestion').value.trim();
        if (question) {
            queryLLM(question);
        }
    });
    
    document.getElementById('llmQuestion')?.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            const question = this.value.trim();
            if (question) queryLLM(question);
        }
    });
    
    // 초기화 - 모든 데이터를 "-" 로 표시
    updateTime();
    
    console.log('대시보드 시작 - 3 초마다 API 폴링 시작...');
    console.log('API Base:', API_BASE);
    
    // 첫 데이터 로드
    fetchParkedStatus();
    fetchEntryExitRecords();
    
    // 주기적 업데이트 (3 초마다)
    setInterval(fetchParkedStatus, REFRESH_INTERVAL);
    setInterval(fetchEntryExitRecords, REFRESH_INTERVAL * 2);
    setInterval(updateTime, 1000);
})();
</script>
}
