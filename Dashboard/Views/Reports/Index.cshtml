@model ParkingDashboard.ViewModels.ReportViewModel
@{ ViewData["Title"] = "LLM 데이터 조회"; }

<h3 class="mb-3"><i class="bi bi-robot"></i> LLM 데이터 조회 <small class="text-muted fs-6">— 음성 인식 지원</small></h3>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><i class="bi bi-lightbulb"></i> 추천 질문 (클릭 或 음성으로)</div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    @foreach (var q in new[] {
                        "현재 주차 차량 수는?",
                        "오늘 입차 수는?",
                        "오늘 수익은?",
                        "이번 달 수익은?",
                        "이번 주 수익은?",
                        "등록된 차량 수는?",
                        "12가 3456 차량 정보"
                    })
                    {
                        <form method="post" asp-controller="Reports" asp-action="Ask" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="question" value="@q" />
                            <button type="submit" class="btn btn-outline-secondary text-start w-100">
                                <i class="bi bi-chat-left-quote"></i> @q
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mt-3">
            <div class="card-header bg-white"><i class="bi bi-info-circle"></i> 음성 안내</div>
            <div class="card-body">
                <small class="text-muted">
                    • 마이크 버튼을 누르고 한국어로 질문하세요.<br />
                    • 예: "오늘 입차 수 알려줘", "12가 3456 차량 정보"<br />
                    • 음성 답변은 <strong>Chrome / Edge / Safari</strong>에서 지원됩니다.<br />
                    • HTTPS 또는 localhost에서만 마이크 사용 가능
                </small>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <!-- 질문 입력 폼 (음성 지원) -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-chat-dots"></i> 질문하기</span>
                <div class="form-check form-switch m-0">
                    <input class="form-check-input" type="checkbox" id="autoSpeak" checked />
                    <label class="form-check-label small" for="autoSpeak">답변을 음성으로 듣기</label>
                </div>
            </div>
            <div class="card-body">
                <form id="askForm" method="post" asp-controller="Reports" asp-action="Ask">
                    @Html.AntiForgeryToken()
                    <div class="input-group">
                        <input type="text" name="question" id="questionInput" class="form-control"
                               placeholder="키보드 또는 마이크로 질문 입력"
                               required autocomplete="off" />
                        <!-- ★ 음성 인식 마이크 버튼 -->
                        <button type="button" id="micBtn" class="btn btn-danger px-3" title="음성으로 질문">
                            <i class="bi bi-mic-fill"></i>
                        </button>
                        <button class="btn btn-primary" type="submit" title="질문 전송">
                            <i class="bi bi-send"></i>
                        </button>
                    </div>
                    <!-- 음성 인식 interim 텍스트 표시 영역 -->
                    <div id="interimBox" class="mt-2 small text-muted" style="display:none;">
                        <i class="bi bi-soundwave"></i>
                        <span id="interimText"></span>
                    </div>
                    <small class="text-muted mt-2 d-block">
                        한국어 자연어를 분석해 DB 조회 후 답변을 생성합니다. (Rule-Based)
                    </small>
                </form>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Question))
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white d-flex justify-content-between">
                    <span><i class="bi bi-person"></i> 질문</span>
                    <small class="text-muted">@Model.AskedAt.ToString("yyyy-MM-dd HH:mm")</small>
                </div>
                <div class="card-body">
                    <p class="mb-0 fw-semibold">@Model.Question</p>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-stars"></i> 답변</span>
                    <!-- ★ 음성 출력 버튼 -->
                    <button type="button" id="speakBtn" class="btn btn-sm btn-outline-warning" title="답변을 음성으로 듣기">
                        <i class="bi bi-volume-up-fill"></i> 음성 듣기
                    </button>
                </div>
                <div class="card-body">
                    <pre id="answerText" class="answer-text"
                         style="white-space: pre-wrap;
                                font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
                                margin: 0; border: 0; background: transparent;">@Model.Answer</pre>

                    @if (Model.Steps.Any())
                    {
                        <hr />
                        <h6 class="text-muted">조회 데이터</h6>
                        <table class="table table-sm">
                            <thead><tr><th>항목</th><th>값</th></tr></thead>
                            <tbody>
                                @foreach (var s in Model.Steps)
                                {
                                    <tr>
                                        <td>@s.Label</td>
                                        <td>@(s.Value is System.Collections.IEnumerable e && !(s.Value is string)
                                                ? string.Join(", ", ((System.Collections.IEnumerable)s.Value).Cast<object>())
                                                : s.Value)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info border-0 shadow-sm">
                <i class="bi bi-info-circle"></i>
                마이크 버튼을 누르고 질문하거나, 추천 질문을 클릭하거나, 직접 입력 후 <kbd>Enter</kbd>로 질문하세요.
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    (function () {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        const speechSynthesis = window.speechSynthesis;

        const micBtn = document.getElementById('micBtn');
        const interimBox = document.getElementById('interimBox');
        const interimText = document.getElementById('interimText');
        const questionInput = document.getElementById('questionInput');
        const askForm = document.getElementById('askForm');
        const speakBtn = document.getElementById('speakBtn');
        const answerText = document.getElementById('answerText');
        const autoSpeak = document.getElementById('autoSpeak');

        // =============[ 음성 인식 ]=============
        let recognition = null;
        let listening = false;

        if (!SpeechRecognition) {
            micBtn.disabled = true;
            micBtn.title = "이 브라우저는 음성 인식을 지원하지 않습니다. (Chrome, Edge, Safari 권장)";
            micBtn.innerHTML = '<i class="bi bi-mic-mute"></i>';
        } else {
            recognition = new SpeechRecognition();
            recognition.lang = 'ko-KR';
            recognition.continuous = false;
            recognition.interimResults = true;
            recognition.maxAlternatives = 1;

            recognition.onstart = () => {
                listening = true;
                micBtn.innerHTML = '<i class="bi bi-mic-fill"></i>聆听';
                micBtn.classList.add('active-mic');
                interimBox.style.display = 'block';
                interimText.textContent = '음성 인식 중...';
            };

            recognition.onresult = (event) => {
                let interim = '', final = '';
                for (let i = event.resultIndex; i < event.results.length; ++i) {
                    const text = event.results[i][0].transcript;
                    if (event.results[i].isFinal) final += text;
                    else interim += text;
                }
                if (interim) interimText.textContent = interim;
                if (final) {
                    questionInput.value = final.trim();
                    interimText.textContent = '✓ 인식됨: ' + final;
                    // 자동 제출
                    setTimeout(() => askForm.submit(), 400);
                }
            };

            recognition.onerror = (event) => {
                interimText.textContent = '⚠ 음성 인식 오류: ' + event.error;
                stopMic();
            };

            recognition.onend = () => {
                stopMic();
            };

            micBtn.addEventListener('click', () => {
                if (listening) {
                    recognition.stop();
                } else {
                    try {
                        recognition.start();
                    } catch (e) {
                        interimText.textContent = '마이크 시작 오류: ' + e.message;
                    }
                }
            });

            function stopMic() {
                listening = false;
                micBtn.innerHTML = '<i class="bi bi-mic-fill"></i>';
                micBtn.classList.remove('active-mic');
            }
        }

        // =============[ 음성 출력 (TTS) ]=============
        function speak(text) {
            if (!speechSynthesis || !text) return;
            speechSynthesis.cancel();
            const utt = new SpeechSynthesisUtterance(text);
            utt.lang = 'ko-KR';
            utt.rate = 1.05;
            utt.pitch = 1.0;
            // 한국어 음성 우선 선택
            const voices = speechSynthesis.getVoices();
            const korean = voices.find(v => v.lang.startsWith('ko')) ||
                           voices.find(v => v.lang.startsWith('ko-KR'));
            if (korean) utt.voice = korean;
            speechSynthesis.speak(utt);
        }

        // 음성 듣기 버튼
        if (speakBtn) {
            speakBtn.addEventListener('click', () => {
                const txt = answerText ? answerText.textContent.trim() : '';
                speak(txt);
                speakBtn.innerHTML = '<i class="bi bi-stop-fill"></i> 멈춤';
                if (speechSynthesis) {
                    speechSynthesis.onend = speechSynthesis.onerror = () => {
                        speakBtn.innerHTML = '<i class="bi bi-volume-up-fill"></i> 음성 듣기';
                    };
                }
            });
        }

        // 자동 음성 출력 (체크박스 ON일 때)
        if (autoSpeak && autoSpeak.checked && answerText && answerText.textContent.trim()) {
            // 페이지 로드 후 약간 기다렸다가 자동 재생
            setTimeout(() => speak(answerText.textContent.trim()), 800);
        }
    })();
</script>
}
