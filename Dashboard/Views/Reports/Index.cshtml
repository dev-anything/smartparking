@model ParkingDashboard.ViewModels.ReportViewModel
@{ ViewData["Title"] = "LLM 데이터 조회"; }

<h3 class="mb-3"><i class="bi bi-robot"></i> LLM 데이터 조회 <small class="text-muted fs-6">— 음성 인식 지원</small></h3>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><i class="bi bi-lightbulb"></i> 추천 질문 (클릭 또는 음성으로)</div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    @foreach (var q in new[] {
                        "현재 주차 차량 수는?",
                        "오늘 입차 수는?",
                        "오늘 수익은?",
                        "이번 달 수익은?",
                        "이번 주 수익은?",
                        "등록된 차량 수는?",
                        "12가 3456 차량 정보"
                    })
                    {
                        <button type="button" class="btn btn-outline-secondary text-start recommend-btn" data-question="@q">
                            <i class="bi bi-chat-left-quote"></i> @q
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mt-3">
            <div class="card-header bg-white"><i class="bi bi-info-circle"></i> 음성 안내</div>
            <div class="card-body">
                <small class="text-muted">
                    • 마이크 버튼을 누르고 한국어로 질문하세요.<br />
                    • 예: "오늘 입차 수 알려줘", "12가 3456 차량 정보"<br />
                    • 음성 답변은 <strong>Chrome / Edge / Safari</strong>에서 지원됩니다.<br />
                    • HTTPS 또는 localhost에서만 마이크 사용 가능
                </small>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-chat-dots"></i> 질문하기</span>
                <div class="form-check form-switch m-0">
                    <input class="form-check-input" type="checkbox" id="autoSpeak" checked />
                    <label class="form-check-label small" for="autoSpeak">답변을 음성으로 듣기</label>
                </div>
            </div>
            <div class="card-body">
                <form id="askForm">
                    <div class="input-group">
                        <input type="text" id="questionInput" class="form-control"
                               placeholder="키보드 또는 마이크로 질문 입력"
                               required autocomplete="off" />
                        <button type="button" id="micBtn" class="btn btn-danger px-3" title="음성으로 질문">
                            <i class="bi bi-mic-fill"></i>
                        </button>
                        <button type="submit" class="btn btn-primary" title="질문 전송">
                            <i class="bi bi-send"></i>
                        </button>
                    </div>
                    <div id="interimBox" class="mt-2 small text-muted" style="display:none;">
                        <i class="bi bi-soundwave"></i>
                        <span id="interimText"></span>
                    </div>
                    <small class="text-muted mt-2 d-block">
                        한국어 자연어를 분석해 DB 조회 후 답변을 생성합니다.
                    </small>
                </form>
            </div>
        </div>

        <div id="resultArea">
            @if (!string.IsNullOrEmpty(Model?.Question))
            {
                <div class="card border-0 shadow-sm mb-3" id="questionCard">
                    <div class="card-header bg-white d-flex justify-content-between">
                        <span><i class="bi bi-person"></i> 질문</span>
                        <small class="text-muted">@Model.AskedAt.ToString("yyyy-MM-dd HH:mm")</small>
                    </div>
                    <div class="card-body">
                        <p class="mb-0 fw-semibold">@Model.Question</p>
                    </div>
                </div>

                <div class="card border-0 shadow-sm" id="answerCard">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-stars"></i> 답변</span>
                        <button type="button" id="speakBtn" class="btn btn-sm btn-outline-warning">
                            <i class="bi bi-volume-up-fill"></i> 음성 듣기
                        </button>
                    </div>
                    <div class="card-body">
                        <pre id="answerText" class="answer-text"
                             style="white-space: pre-wrap; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; margin: 0; border: 0; background: transparent;">@Model.Answer</pre>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info border-0 shadow-sm" id="guideMsg">
                    <i class="bi bi-info-circle"></i>
                    마이크 버튼을 누르고 질문하거나, 추천 질문을 클릭하거나, 직접 입력 후 <kbd>Enter</kbd>로 질문하세요.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        const LLM_API_URL = 'http://192.168.0.7:10001/api/llm-query';

        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        const speechSynthesis = window.speechSynthesis;

        const micBtn = document.getElementById('micBtn');
        const interimBox = document.getElementById('interimBox');
        const interimText = document.getElementById('interimText');
        const questionInput = document.getElementById('questionInput');
        const askForm = document.getElementById('askForm');
        const autoSpeak = document.getElementById('autoSpeak');
        const resultArea = document.getElementById('resultArea');
        const guideMsg = document.getElementById('guideMsg');

        async function callLLM(question) {
            console.log('LLM 요청:', question);
            console.log('요청 URL:', LLM_API_URL);
            try {
                const response = await fetch(LLM_API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ question: question })
                });
                console.log('응답 상태:', response.status, response.statusText);
                if (!response.ok) {
                    const txt = await response.text();
                    throw new Error('서버 응답 오류: ' + response.status + ' ' + txt);
                }
                const data = await response.text();
                console.log('LLM 응답:', data);
                return data;
            } catch (error) {
                console.error('LLM API 오류:', error);
                return null;
            }
        }

        function showResult(question, answer) {
            if (guideMsg) guideMsg.style.display = 'none';
            var existing = resultArea.querySelectorAll('.card');
            existing.forEach(function(el) { el.remove(); });

            var now = new Date();
            var timeStr = now.getFullYear() + '-' + 
                          String(now.getMonth()+1).padStart(2,'0') + '-' + 
                          String(now.getDate()).padStart(2,'0') + ' ' + 
                          String(now.getHours()).padStart(2,'0') + ':' + 
                          String(now.getMinutes()).padStart(2,'0');

            var qHtml = '<div class="card border-0 shadow-sm mb-3">' +
                '<div class="card-header bg-white d-flex justify-content-between">' +
                '<span><i class="bi bi-person"></i> 질문</span>' +
                '<small class="text-muted">' + timeStr + '</small>' +
                '</div>' +
                '<div class="card-body"><p class="mb-0 fw-semibold">' + escapeHtml(question) + '</p></div></div>';

            var aHtml = '<div class="card border-0 shadow-sm">' +
                '<div class="card-header bg-white d-flex justify-content-between align-items-center">' +
                '<span><i class="bi bi-stars"></i> 답변</span>' +
                '<button type="button" id="speakBtn" class="btn btn-sm btn-outline-warning">' +
                '<i class="bi bi-volume-up-fill"></i> 음성 듣기</button>' +
                '</div>' +
                '<div class="card-body">' +
                '<pre id="answerText" class="answer-text" style="white-space: pre-wrap; font-family: -apple-system, BlinkMacSystemFont, \'Segoe UI\', sans-serif; margin: 0; border: 0; background: transparent;">' + escapeHtml(answer) + '</pre>' +
                '</div></div>';

            resultArea.insertAdjacentHTML('beforeend', qHtml + aHtml);

            document.getElementById('speakBtn').addEventListener('click', function() {
                var txt = document.getElementById('answerText').textContent.trim();
                speak(txt);
                this.innerHTML = '<i class="bi bi-stop-fill"></i> 재생중';
                var self = this;
                speechSynthesis.onend = speechSynthesis.onerror = function() {
                    self.innerHTML = '<i class="bi bi-volume-up-fill"></i> 음성 듣기';
                };
            });

            if (autoSpeak && autoSpeak.checked) {
                setTimeout(function() { speak(answer); }, 500);
            }
        }

        function showError(question, errorMsg) {
            if (guideMsg) guideMsg.style.display = 'none';
            var existing = resultArea.querySelectorAll('.card');
            existing.forEach(function(el) { el.remove(); });

            var qHtml = '<div class="card border-0 shadow-sm mb-3">' +
                '<div class="card-header bg-white"><span><i class="bi bi-person"></i> 질문</span></div>' +
                '<div class="card-body"><p class="mb-0 fw-semibold">' + escapeHtml(question) + '</p></div></div>';

            var aHtml = '<div class="card border-0 shadow-sm border-danger">' +
                '<div class="card-header bg-danger text-white"><span><i class="bi bi-exclamation-triangle"></i> 오류</span></div>' +
                '<div class="card-body"><pre style="white-space: pre-wrap; margin: 0; color: #dc3545;">' + escapeHtml(errorMsg) + '</pre></div></div>';

            resultArea.insertAdjacentHTML('beforeend', qHtml + aHtml);
        }

        function escapeHtml(str) {
            var div = document.createElement('div');
            div.appendChild(document.createTextNode(str));
            return div.innerHTML;
        }

        function speak(text) {
            if (!speechSynthesis || !text) return;
            speechSynthesis.cancel();
            var utt = new SpeechSynthesisUtterance(text);
            utt.lang = 'ko-KR';
            var voices = speechSynthesis.getVoices();
            var korean = voices.find(function(v) { return v.lang.startsWith('ko'); });
            if (korean) utt.voice = korean;
            speechSynthesis.speak(utt);
        }

        async function submitQuestion(question) {
            if (!question || !question.trim()) return;
            var submitBtn = askForm.querySelector('button[type="submit"]');
            var orig = submitBtn.innerHTML;
            submitBtn.innerHTML = '<i class="bi bi-hourglass-split"></i>';
            submitBtn.disabled = true;

            var result = await callLLM(question.trim());
            submitBtn.innerHTML = orig;
            submitBtn.disabled = false;

            if (result !== null && typeof result === 'string') {
                showResult(question.trim(), result);
            } else if (result !== null && typeof result === 'object') {
                var answer = result.answer || result.sql || JSON.stringify(result, null, 2);
                showResult(question.trim(), answer);
            } else {
                showError(question.trim(), '서버에 연결할 수 없습니다.\n192.168.0.7:10001 서버 상태를 확인해주세요.');
            }
        }

        askForm.addEventListener('submit', function(e) {
            e.preventDefault();
            var q = questionInput.value.trim();
            if (q) submitQuestion(q);
        });

        document.querySelectorAll('.recommend-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var q = btn.getAttribute('data-question');
                questionInput.value = q;
                submitQuestion(q);
            });
        });

        let recognition = null;
        let listening = false;

        if (!SpeechRecognition) {
            micBtn.disabled = true;
            micBtn.title = "이 브라우저는 음성 인식을 지원하지 않습니다.";
            micBtn.innerHTML = '<i class="bi bi-mic-mute"></i>';
        } else {
            recognition = new SpeechRecognition();
            recognition.lang = 'ko-KR';
            recognition.continuous = false;
            recognition.interimResults = true;

            recognition.onstart = function() {
                listening = true;
                micBtn.innerHTML = '<i class="bi bi-mic-fill"></i> 인식중';
                micBtn.classList.add('active-mic');
                interimBox.style.display = 'block';
                interimText.textContent = '음성 인식 중...';
            };

            recognition.onresult = function(event) {
                var interim = '', final = '';
                for (var i = event.resultIndex; i < event.results.length; ++i) {
                    var text = event.results[i][0].transcript;
                    if (event.results[i].isFinal) final += text;
                    else interim += text;
                }
                if (interim) interimText.textContent = interim;
                if (final) {
                    questionInput.value = final.trim();
                    interimText.textContent = '✓ 인식됨: ' + final;
                    setTimeout(function() { submitQuestion(final.trim()); }, 400);
                }
            };

            recognition.onerror = function(event) {
                interimText.textContent = '⚠ 음성 인식 오류: ' + event.error;
                stopMic();
            };

            recognition.onend = function() { stopMic(); };

            micBtn.addEventListener('click', function() {
                if (listening) recognition.stop();
                else {
                    try { recognition.start(); }
                    catch (e) { interimText.textContent = '마이크 시작 오류: ' + e.message; }
                }
            });

            function stopMic() {
                listening = false;
                micBtn.innerHTML = '<i class="bi bi-mic-fill"></i>';
                micBtn.classList.remove('active-mic');
            }
        }

        if (autoSpeak && autoSpeak.checked && document.getElementById('answerText')) {
            setTimeout(function() { speak(document.getElementById('answerText').textContent.trim()); }, 800);
        }
    })();
</script>
}