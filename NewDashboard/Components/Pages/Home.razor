@page "/"
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<!-- HEADER -->
<header class="fixed top-0 left-0 w-full z-50 bg-white border-b border-slate-200">
    <div class="h-16 w-full max-w-[1920px] mx-auto px-6 lg:px-10 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-blue-700 flex items-center justify-center text-white font-bold">P</div>
            <span class="font-bold text-lg text-slate-900 tracking-tight">스마트 주차 관제 대시보드</span>
        </div>

        <!-- 관리자 로그인 영역 -->
        <div class="flex items-center gap-3">
            @if (isAdminLoggedIn)
            {
                <div class="flex items-center gap-2 bg-indigo-50 border border-indigo-200 px-3.5 py-1.5 rounded-full">
                    <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
                    <span class="text-xs text-indigo-900 font-bold">최고관리자 (admin)</span>
                    <button @onclick="HandleLogout" class="ml-1 text-slate-400 hover:text-rose-600 flex items-center cursor-pointer" title="로그아웃">
                        <span class="material-symbols-outlined text-[16px]">logout</span>
                    </button>
                </div>
            }
            else
            {
                <button @onclick="OpenLoginModal" class="flex items-center gap-1.5 px-4 py-2 rounded-full bg-blue-700 hover:bg-blue-800 text-white text-xs font-medium shadow-md transition-all cursor-pointer">
                    <span class="material-symbols-outlined text-[16px]">admin_panel_settings</span>
                    <span>관리자 로그인</span>
                </button>
            }
        </div>
    </div>
</header>

<!-- MAIN CONTAINER -->
<main class="w-full pt-20 bg-slate-50 min-h-screen">
    <div class="w-full max-w-[1920px] mx-auto px-6 lg:px-10 py-6">

        <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 items-start">
            
            <!-- LEFT COLUMN (8 Cols) -->
            <div class="xl:col-span-8 flex flex-col gap-6">
                
                <!-- 차량 검색 및 카드 등록 -->
                <div class="bg-white rounded-xl p-5 border border-slate-200">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                        <div class="flex-1 max-w-xl">
                            <div class="flex items-center gap-2">
                                <div class="relative flex-1">
                                    <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">search</span>
                                    <input @bind="carNumberInput" @bind:event="oninput" class="w-full h-11 pl-10 pr-4 bg-slate-50 text-slate-900 placeholder:text-slate-400 text-xs rounded-xl focus:outline-none focus:bg-white border border-slate-200" placeholder="차량번호 입력 (예: 12가 3456)" />
                                </div>
                                <button @onclick="HandleCardRegister" class="h-11 px-6 bg-blue-700 text-white text-xs font-medium rounded-full hover:bg-blue-800 transition-all flex items-center gap-1.5 shrink-0 cursor-pointer">
                                    <span class="material-symbols-outlined text-[17px]">credit_card</span>
                                    <span>카드등록</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    @if (showToast)
                    {
                        <div class="mt-3 p-3 rounded-lg bg-slate-100 text-slate-700 text-xs flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-blue-700 text-[18px]">info</span>
                                <span>@toastMessage</span>
                            </div>
                            <button @onclick="() => showToast = false" class="text-slate-400 hover:text-slate-600 text-xs">닫기</button>
                        </div>
                    }
                </div>

                <!-- 실시간 주차 현황 (초기 깨끗한 상태) -->
                <div class="bg-white rounded-xl p-6 border border-slate-200 flex flex-col gap-5">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <span class="w-1.5 h-4 rounded-full bg-blue-700"></span>
                            <h2 class="font-bold text-base text-slate-900">실시간 주차 현황</h2>
                        </div>
                        <div class="flex items-center gap-4 text-xs text-slate-500 font-mono">
                            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-xs bg-emerald-100 border border-emerald-500 inline-block"></span>비어있음 (6)</span>
                            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-xs bg-rose-600 inline-block"></span>주차중 (0)</span>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <!-- Upper Slots: 01, 02, 03 -->
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            @for (int i = 1; i <= 3; i++)
                            {
                                var slotNum = i.ToString("D2");
                                <div class="bg-slate-50 rounded-xl p-4 border border-dashed border-emerald-300">
                                    <div class="flex items-center justify-between mb-2">
                                        <span class="font-bold text-lg text-slate-400">@slotNum</span>
                                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-emerald-100 text-emerald-800">비어있음</span>
                                    </div>
                                    <div class="py-2 text-center">
                                        <span class="material-symbols-outlined text-[24px] text-emerald-600">local_parking</span>
                                        <span class="text-xs text-emerald-700 mt-1 block font-medium">주차 가능 구역</span>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- 통로 -->
                        <div class="relative w-full h-8 bg-slate-800 rounded-xl flex items-center justify-between px-6 overflow-hidden">
                            <div class="flex items-center justify-center gap-3 w-full">
                                <span class="w-8 h-1 bg-amber-400 rounded opacity-60"></span>
                                <span class="w-8 h-1 bg-amber-400 rounded opacity-60"></span>
                                <span class="w-8 h-1 bg-amber-400 rounded opacity-60"></span>
                            </div>
                        </div>

                        <!-- Lower Slots: 04, 05, 06 -->
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            @for (int i = 4; i <= 6; i++)
                            {
                                var slotNum = i.ToString("D2");
                                <div class="bg-slate-50 rounded-xl p-4 border border-dashed border-emerald-300">
                                    <div class="flex items-center justify-between mb-2">
                                        <span class="font-bold text-lg text-slate-400">@slotNum</span>
                                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-emerald-100 text-emerald-800">비어있음</span>
                                    </div>
                                    <div class="py-2 text-center">
                                        <span class="material-symbols-outlined text-[24px] text-emerald-600">local_parking</span>
                                        <span class="text-xs text-emerald-700 mt-1 block font-medium">주차 가능 구역</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- 하단 패널 (차량확인 & 수익 현황 초기화) -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- 차량확인 패널 -->
                    <div class="bg-white rounded-xl p-5 border border-slate-200 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center gap-2 mb-4">
                                <span class="material-symbols-outlined text-blue-700 text-[20px]">photo_camera</span>
                                <h3 class="font-bold text-sm text-slate-900">차량확인</h3>
                            </div>
                            <div class="relative bg-slate-100 rounded-xl h-36 flex flex-col items-center justify-center mb-4 border border-slate-200 text-slate-400">
                                <span class="material-symbols-outlined text-3xl mb-1">videocam_off</span>
                                <span class="text-xs">실시간 입출차 카메라 대기 중</span>
                            </div>
                            <div class="p-4 text-center text-slate-400 text-xs bg-slate-50 rounded-lg">
                                최근 입출차 기록이 없습니다.
                            </div>
                        </div>
                    </div>

                    <!-- 수익 현황 패널 -->
                    <div class="bg-white rounded-xl p-5 border border-slate-200 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-blue-700 text-[20px]">payments</span>
                                    <h3 class="font-bold text-sm text-slate-900">수익 현황</h3>
                                </div>
                                <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 font-medium">오늘 기준</span>
                            </div>
                            <div class="grid grid-cols-2 gap-3 mb-4">
                                <div class="bg-slate-50 p-3.5 rounded-xl">
                                    <span class="text-slate-500 text-[11px] block">금일 누적 매출</span>
                                    <span class="text-lg font-bold text-slate-900 font-mono">₩0</span>
                                </div>
                                <div class="bg-slate-50 p-3.5 rounded-xl">
                                    <span class="text-slate-500 text-[11px] block">이달 예상 매출</span>
                                    <span class="text-lg font-bold text-blue-700 font-mono">₩0</span>
                                </div>
                            </div>
                            <div class="bg-slate-50 p-3 rounded-xl">
                                <div class="flex items-center justify-between text-[11px] text-slate-500 mb-2">
                                    <span>최근 7일 정산 추이</span>
                                    <span class="font-medium text-slate-700">평균 ₩0/일</span>
                                </div>
                                <svg class="w-full h-12" fill="none" viewBox="0 0 280 50">
                                    <path d="M 0 45 L 280 45" fill="none" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="4 4"></path>
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: LLM Assistant -->
            <div class="xl:col-span-4 flex flex-col">
                <div class="bg-white rounded-xl border border-slate-200 flex flex-col h-[750px]">
                    <div class="p-4 bg-white flex items-center justify-between rounded-t-xl border-b border-slate-200">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-full bg-blue-50 flex items-center justify-center text-blue-700">
                                <span class="material-symbols-outlined text-[20px]">smart_toy</span>
                            </div>
                            <h3 class="font-bold text-sm text-slate-900">LLM 주차 도우미</h3>
                        </div>
                        <button @onclick="ClearChat" class="text-slate-400 hover:text-slate-600 p-1 rounded-full hover:bg-slate-50 cursor-pointer" title="대화 초기화">
                            <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                        </button>
                    </div>

                    <div class="flex-1 overflow-y-auto p-4 space-y-3.5 text-xs">
                        @foreach (var msg in chatMessages)
                        {
                            if (msg.IsUser)
                            {
                                <div class="flex items-start justify-end gap-2">
                                    <div class="flex flex-col items-end gap-1 max-w-[85%]">
                                        <div class="bg-blue-700 text-white p-3 rounded-2xl rounded-tr-xs leading-relaxed">
                                            @msg.Text
                                        </div>
                                    </div>
                                    <div class="w-7 h-7 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center shrink-0 text-[11px] font-bold">나</div>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-start gap-2">
                                    <div class="w-7 h-7 rounded-full bg-blue-600 text-white flex items-center justify-center shrink-0 text-[11px] font-bold">AI</div>
                                    <div class="flex flex-col gap-1 max-w-[85%]">
                                        <div class="bg-slate-100 text-slate-900 p-3 rounded-2xl rounded-tl-xs leading-relaxed">
                                            @((MarkupString)msg.Text)
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="p-3 bg-white rounded-b-xl border-t border-slate-200">
                        <form @onsubmit="HandleSendChat" class="flex items-center gap-2">
                            <input @bind="userChatInput" class="flex-1 h-11 px-3.5 bg-slate-50 text-slate-900 placeholder:text-slate-400 text-xs rounded-xl focus:outline-none border border-slate-200" placeholder="AI에게 질문해 보세요... (예: 12가 3456)" />
                            <button type="submit" class="w-11 h-11 rounded-full bg-blue-700 hover:bg-blue-800 text-white flex items-center justify-center shrink-0 cursor-pointer">
                                <span class="material-symbols-outlined text-[18px]">send</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>
</main>

<!-- ID/PW 입력 관리자 로그인 모달 -->
@if (isLoginModalOpen)
{
    <div class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white border border-slate-200 rounded-2xl w-full max-w-md p-6 shadow-2xl">
            <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                <h3 class="text-base font-bold text-slate-900">관리자 로그인</h3>
                <button @onclick="CloseLoginModal" class="text-slate-400 hover:text-slate-700 cursor-pointer">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            
            <div class="my-4 space-y-3.5">
                <div>
                    <label class="block text-xs font-medium text-slate-500 mb-1">아이디</label>
                    <input @bind="adminIdInput" class="w-full h-10 px-3.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500/20" placeholder="아이디 입력" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-500 mb-1">비밀번호</label>
                    <input @bind="adminPwInput" type="password" class="w-full h-10 px-3.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500/20" placeholder="비밀번호 입력" />
                </div>

                @if (!string.IsNullOrEmpty(loginErrorMsg))
                {
                    <div class="text-xs text-rose-600 font-medium pt-1">@loginErrorMsg</div>
                }

                <div class="flex justify-end gap-2 pt-3">
                    <button @onclick="CloseLoginModal" class="px-4 py-2.5 bg-slate-100 text-xs font-medium rounded-xl text-slate-700 hover:bg-slate-200 cursor-pointer">취소</button>
                    <button @onclick="HandleAdminLogin" class="px-5 py-2.5 bg-blue-700 hover:bg-blue-800 text-white text-xs font-bold rounded-xl shadow-md cursor-pointer">로그인</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string carNumberInput = "";
    private string toastMessage = "";
    private bool showToast = false;

    // 관리자 로그인 상태 변수
    private bool isLoginModalOpen = false;
    private bool isAdminLoggedIn = false;
    private string adminIdInput = "";
    private string adminPwInput = "";
    private string loginErrorMsg = "";

    private string userChatInput = "";
    private List<ChatMessage> chatMessages = new()
    {
        new ChatMessage { IsUser = false, Text = "안녕하세요! 주차 관제 AI 도우미입니다. 차량 번호 조회 및 자동 결제 안내가 가능합니다." }
    };

    private async Task HandleCardRegister()
    {
        if (string.IsNullOrWhiteSpace(carNumberInput))
        {
            toastMessage = "※ 카드등록을 하려면 먼저 차량번호를 입력해야 합니다.";
            showToast = true;
            return;
        }

        try
        {
            string hexCarNum = Convert.ToHexString(System.Text.Encoding.UTF8.GetBytes(carNumberInput));
            string customerKey = $"CAR_{hexCarNum}_{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";
            string clientKey = "test_ck_LlDJaYngroeN4YPxKGdN3ezGdRpX";

            await JSRuntime.InvokeVoidAsync("requestTossBilling", clientKey, customerKey, carNumberInput);
        }
        catch (Exception ex)
        {
            toastMessage = $"토스 연동 오류: {ex.Message}";
            showToast = true;
        }
    }

    private void OpenLoginModal()
    {
        adminIdInput = "";
        adminPwInput = "";
        loginErrorMsg = "";
        isLoginModalOpen = true;
    }

    private void CloseLoginModal()
    {
        isLoginModalOpen = false;
        loginErrorMsg = "";
    }

    private void HandleAdminLogin()
    {
        if (adminIdInput == "admin" && adminPwInput == "admin")
        {
            isAdminLoggedIn = true;
            isLoginModalOpen = false;
            loginErrorMsg = "";
            adminIdInput = "";
            adminPwInput = "";
            toastMessage = "최고관리자로 성공적으로 로그인되었습니다.";
            showToast = true;
        }
        else
        {
            loginErrorMsg = "아이디 또는 비밀번호가 올바르지 않습니다.";
        }
    }

    private void HandleLogout()
    {
        isAdminLoggedIn = false;
        toastMessage = "관리자 로그아웃 처리되었습니다.";
        showToast = true;
    }

    private void HandleSendChat()
    {
        if (string.IsNullOrWhiteSpace(userChatInput)) return;

        chatMessages.Add(new ChatMessage { IsUser = true, Text = userChatInput });
        var query = userChatInput;
        userChatInput = "";

        chatMessages.Add(new ChatMessage { IsUser = false, Text = $"현재 시스템 초기 상태입니다. 문의하신 [<b>{query}</b>] 차량의 입차 데이터가 등록되어 있지 않습니다." });
    }

    private void ClearChat()
    {
        chatMessages.Clear();
        chatMessages.Add(new ChatMessage { IsUser = false, Text = "대화 목록이 초기화되었습니다." });
    }

    public class ChatMessage
    {
        public bool IsUser { get; set; }
        public string Text { get; set; } = "";
    }
}