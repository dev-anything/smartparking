@page "/billing-success"
@inject NavigationManager Navigation
@inject HttpClient Http
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="min-h-screen bg-surface flex items-center justify-center p-6 font-sans">
    <div class="bg-canvas border border-hairline rounded-2xl p-8 max-w-md w-full shadow-xl text-center">
        @if (isLoading)
        {
            <div class="py-8">
                <div class="w-12 h-12 border-4 border-primary border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
                <h2 class="text-base font-bold text-on-surface">토스 카드 등록 승인 중...</h2>
                <p class="text-xs text-ink-mute mt-1">C# 백엔드로 빌링키 발급 요청 전송 중</p>
            </div>
        }
        else if (isSuccess)
        {
            <div class="py-4">
                <div class="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-3">
                    <span class="material-symbols-outlined text-3xl">check_circle</span>
                </div>
                <h2 class="text-lg font-bold text-on-surface">자동결제 카드 등록 완료!</h2>
                <p class="text-xs text-ink-mute mt-1">차량번호: <b class="text-primary font-mono">@carNumber</b></p>
                <div class="mt-4 p-3 bg-canvas-soft rounded-xl text-left text-xs font-mono border border-hairline space-y-1">
                    <div class="text-slate-500">발급된 BillingKey:</div>
                    <div class="text-emerald-600 font-bold break-all">@billingKey</div>
                </div>
                <button @onclick='() => Navigation.NavigateTo("/")' class="mt-6 w-full py-2.5 bg-primary text-on-primary text-xs font-bold rounded-xl shadow-md hover:bg-primary-deep cursor-pointer">
                    대시보드로 돌아가기
                </button>
            </div>
        }
        else
        {
            <div class="py-4">
                <div class="w-14 h-14 bg-rose-100 text-rose-600 rounded-full flex items-center justify-center mx-auto mb-3">
                    <span class="material-symbols-outlined text-3xl">error</span>
                </div>
                <h2 class="text-lg font-bold text-on-surface">카드 등록 승인 실패</h2>
                <p class="text-xs text-rose-600 mt-1 font-mono break-all px-2">@errorMessage</p>
                <button @onclick='() => Navigation.NavigateTo("/")' class="mt-6 w-full py-2.5 bg-canvas-soft text-ink-secondary text-xs font-bold rounded-xl border border-hairline cursor-pointer">
                    대시보드로 돌아가기
                </button>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? authKey { get; set; }
    [SupplyParameterFromQuery] public string? customerKey { get; set; }
    [SupplyParameterFromQuery] public string? carNumber { get; set; }

    private bool isLoading = true;
    private bool isSuccess = false;
    private string billingKey = "";
    private string errorMessage = "";

    // 화면 렌더링 완료 후 최초 1회만 호출 (Prerender 중복 호출 방지)
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (string.IsNullOrEmpty(authKey) || string.IsNullOrEmpty(customerKey))
            {
                isLoading = false;
                errorMessage = "필수 인증 키가 누락되었습니다.";
                StateHasChanged();
                return;
            }

            try
            {
                // [5단계] C# 백엔드로 TossAuthKey 승인 요청 전송
                var requestData = new { tossAuthKey = authKey, tossCustomerKey = customerKey, carNumber = carNumber ?? "" };
                var response = await Http.PostAsJsonAsync(Navigation.BaseUri + "api/billing/issue", requestData);

                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<BillingResponse>();
                    if (result != null && result.success)
                    {
                        isSuccess = true;
                        billingKey = result.billingKey;
                    }
                    else
                    {
                        errorMessage = result?.message ?? "승인 처리 오류";
                    }
                }
                else
                {
                    string errBody = await response.Content.ReadAsStringAsync();
                    errorMessage = $"토스 승인 에러: {errBody}";
                }
            }
            catch (Exception ex)
            {
                errorMessage = ex.Message;
            }
            finally
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    public class BillingResponse
    {
        public bool success { get; set; }
        public string message { get; set; } = "";
        public string billingKey { get; set; } = "";
    }
}