<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="220" d:DesignHeight="600"
             xmlns:vm="using:vipass_dashboard.ViewModels"
             x:Class="vipass_dashboard.Views.SidebarView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- 메뉴 버튼: 배경 투명, 가로 전체, 왼쪽 정렬 -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D1D5DB" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <!-- Fluent 테마는 마우스 오버 시 템플릿 안쪽 배경을 바꾸므로 템플릿까지 지정해야 한다 -->
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#374151" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <Border Background="#111827" Padding="12">
        <DockPanel LastChildFill="False">

            <!-- 상단: 앱 이름 -->
            <TextBlock DockPanel.Dock="Top"
                       Text="관리자 대시보드"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="12,8,12,20" />

            <!-- 중간: 페이지 메뉴 -->
            <StackPanel DockPanel.Dock="Top" Spacing="1">
                <Button Classes="nav" Content="대시보드" Command="{Binding NavigateToDashboardCommand}" />
                <Button Classes="nav" Content="결제내역" />
                <Button Classes="nav" Content="출입기록" />
                <Button Classes="nav" Content="차량 등록" Command="{Binding NavigateToRegisterCarInfoCommand}" />
            </StackPanel>

            <!-- 하단: 로그아웃 -->
            <Button DockPanel.Dock="Bottom" Classes="nav" Content="로그아웃" />

        </DockPanel>
    </Border>

</UserControl>
