<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:vipass_dashboard.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="vipass_dashboard.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Design.DataContext>
        <vm:DashboardViewModel />
    </Design.DataContext>

    <StackPanel Margin="24" Spacing="8">
        <TextBlock Text="대시보드" FontSize="24" FontWeight="Bold" />
        <TextBlock Text="입출구 차량 정보, 주차장 현황, LLM 채팅이 들어올 자리입니다." />
    </StackPanel>

</UserControl>
