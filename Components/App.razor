<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>스마트 주차 관제 대시보드</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@100..900&display=swap" rel="stylesheet" />
    
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- 토스페이먼츠 SDK -->
    <script src="https://js.tosspayments.com/v1/payment"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#3904e7",
                        "primary-soft": "#665efd",
                        "primary-deep": "#4434d4",
                        "on-primary": "#ffffff",
                        "canvas": "#ffffff",
                        "canvas-soft": "#f6f9fc",
                        "surface": "#f8f9ff",
                        "surface-container": "#e5eeff",
                        "surface-container-low": "#eef4ff",
                        "on-surface": "#031d34",
                        "ink-mute": "#64748d",
                        "ink-secondary": "#273951",
                        "hairline": "#e3e8ee"
                    }
                }
            }
        };
    </script>
    <HeadOutlet />
</head>

<body class="bg-surface font-sans antialiased min-h-screen">
    <Routes />
    <script src="_framework/blazor.web.js"></script>

    <!-- 토스페이먼츠 2단계 카드 인증 창 호출 함수 -->
    <script>
        window.requestTossBilling = function (clientKey, customerKey, carNumber) {
            var tossPayments = TossPayments(clientKey);
            tossPayments.requestBillingAuth('카드', {
                customerKey: customerKey,
                successUrl: window.location.origin + '/billing-success?carNumber=' + encodeURIComponent(carNumber),
                failUrl: window.location.origin + '/billing-fail'
            }).catch(function (error) {
                if (error.code === 'USER_CANCEL') {
                    alert('카드 등록이 취소되었습니다.');
                } else {
                    alert('토스 연동 에러: ' + error.message);
                }
            });
        };
    </script>
</body>

</html>